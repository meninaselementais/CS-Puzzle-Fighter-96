config_version=5

[application]
config/name="Counter-Strike Puzzle Fighter '96 — Laboratório"
run/main_scene="res://coin_flip.tscn"

[display]
window/size/viewport_width=1000
window/size/viewport_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.035,0.045,0.075,1)
